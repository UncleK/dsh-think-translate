{
  "name": "dsh-think-translate",
  "description": "Display-layer translation for the DSH web app: thinking chain, task cards, and optional answer text, in 8 target languages (local Ollama / any OpenAI-compatible or Anthropic endpoint / Google / Bing, fail-open)",
  "version": "1.2.4",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "demo"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "translation",
    "think-translate",
    "ollama",
    "openai-compatible",
    "anthropic",
    "i18n"
  ],
  "homepage": "https://github.com/UncleK/dsh-think-translate#readme",
  "bugs": {
    "url": "https://github.com/UncleK/dsh-think-translate/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UncleK/dsh-think-translate.git"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.0-rc.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.7 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.5-rc.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  },
  "license": "MIT"
}
